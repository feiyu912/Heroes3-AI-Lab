{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:heroes3-ai-lab:expert-demonstration-v1",
  "title": "Unified expert demonstration bundle",
  "type": "object",
  "required": [
    "schema",
    "source",
    "episode",
    "decisions"
  ],
  "properties": {
    "schema": {
      "const": "expert-demonstration-v1"
    },
    "source": {
      "type": "object",
      "required": [
        "kind",
        "trajectory_origin",
        "verified",
        "creator",
        "version",
        "source_reference",
        "permission",
        "verification_evidence"
      ],
      "properties": {
        "kind": {
          "enum": [
            "script",
            "search",
            "human_structured"
          ]
        },
        "trajectory_origin": {
          "enum": [
            "engine_execution",
            "human_recorded",
            "experimental_reconstruction"
          ]
        },
        "verified": {
          "type": "boolean"
        },
        "creator": {
          "type": [
            "string",
            "null"
          ]
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_reference": {
          "type": [
            "string",
            "null"
          ]
        },
        "permission": {
          "type": [
            "string",
            "null"
          ]
        },
        "verification_evidence": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "path": {
              "type": "string"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "path",
            "sha256"
          ]
        }
      }
    },
    "episode": {
      "type": "object",
      "required": [
        "battle_id",
        "tactic_id",
        "scenario_seed",
        "actor_side",
        "rules_version",
        "outcome",
        "permanent_army_loss",
        "quality_tier",
        "verification_evidence"
      ],
      "properties": {
        "battle_id": {
          "type": "string",
          "minLength": 1
        },
        "tactic_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "scenario_seed": {
          "type": [
            "integer",
            "null"
          ]
        },
        "actor_side": {
          "enum": [
            0,
            1,
            null
          ]
        },
        "rules_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "outcome": {
          "type": [
            "object",
            "null"
          ]
        },
        "permanent_army_loss": {
          "type": [
            "object",
            "null"
          ]
        },
        "quality_tier": {
          "enum": [
            "Q0",
            "Q1",
            "Q2",
            "Q3",
            "Q4"
          ]
        },
        "verification_evidence": {
          "type": [
            "object",
            "null"
          ]
        }
      }
    },
    "decisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "observation",
          "legal_actions",
          "expert_action",
          "actor_side",
          "tactic_id",
          "battle_id",
          "scenario_seed",
          "expert_version",
          "action_origin",
          "action_value"
        ],
        "properties": {
          "observation": {
            "type": [
              "object",
              "null"
            ]
          },
          "legal_actions": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "integer"
            },
            "uniqueItems": true,
            "minItems": 1
          },
          "expert_action": {
            "type": [
              "integer",
              "null"
            ]
          },
          "actor_side": {
            "enum": [
              0,
              1,
              null
            ]
          },
          "tactic_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "battle_id": {
            "type": "string"
          },
          "scenario_seed": {
            "type": [
              "integer",
              "null"
            ]
          },
          "expert_version": {
            "type": [
              "string",
              "null"
            ]
          },
          "action_origin": {
            "enum": [
              "engine_executed",
              "human_recorded",
              "unknown"
            ]
          },
          "action_value": {
            "type": [
              "number",
              "null"
            ]
          }
        }
      }
    }
  },
  "additionalProperties": false
}
