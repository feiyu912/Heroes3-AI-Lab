      "lines": [
        "void ApplyGhNetPackVisitor::visitRecruitCreatures(RecruitCreatures & pack)",
        "{",
        "\tgh.throwIfWrongPlayer(connection, &pack);",
        "\tgh.throwIfPlayerNotActive(connection, &pack);",
        "\t// ownership checks are inside recruitCreatures",
        "\tresult = gh.recruitCreatures(pack.tid, pack.dst, pack.crid, pack.amount, pack.level, pack.player);",
        "}"
      ]
    },
    "lib/callback/CCallback.cpp": {
      "path": "/root/heroes3-ai-lab/src/vcmi-adv/lib/callback/CCallback.cpp",
      "sha256": "acfadeb43555667dc421cf882f097622ac9389ebc2b02fbab692c958066ab7d0",
      "start_line": 64,
      "end_line": 72,
      "lines": [
        "void CCallback::recruitCreatures(const CGDwelling * obj, const CArmedInstance * dst, CreatureID ID, ui32 amount, si32 level)",
        "{",
        "\t// TODO exception for neutral dwellings shouldn't be hardcoded",
        "\tif(getPlayerID() != obj->tempOwner && obj->ID != Obj::WAR_MACHINE_FACTORY && obj->ID != Obj::REFUGEE_CAMP)",
        "\t\treturn;",
        "",
        "\tRecruitCreatures pack(obj->id, dst->id, ID, amount, level);",
        "\tsendRequest(pack);",
        "}"
      ]
    },
    "lib/networkPacks/PacksForServer.h": {
      "path": "/root/heroes3-ai-lab/src/vcmi-adv/lib/networkPacks/PacksForServer.h",
      "sha256": "7383cda72ad31b00c697101403c57dd0661601e2decfc54aa7f5134afa12eebb",
      "start_line": 322,
      "end_line": 350,
      "lines": [
        "struct DLL_LINKAGE RecruitCreatures : public CPackForServer",
        "{",
        "\tRecruitCreatures() = default;",
        "\tRecruitCreatures(const ObjectInstanceID & TID, const ObjectInstanceID & DST, const CreatureID & CRID, si32 Amount, si32 Level)",
        "\t\t: tid(TID)",
        "\t\t, dst(DST)",
        "\t\t, crid(CRID)",
        "\t\t, amount(Amount)",
        "\t\t, level(Level)",
        "\t{",
        "\t}",
        "\tObjectInstanceID tid; //dwelling id, or town",
        "\tObjectInstanceID dst; //destination ID, e.g. hero",
        "\tCreatureID crid;",
        "\tui32 amount = 0; //creature amount",
        "\tsi32 level = 0; //dwelling level to buy from, -1 if any",
        "",
        "\tvoid visitTyped(ICPackVisitor & visitor) override;",
        "",
        "\ttemplate <typename Handler> void serialize(Handler & h)",
        "\t{",
        "\t\th & static_cast<CPackForServer &>(*this);",
        "\t\th & tid;",
        "\t\th & dst;",
        "\t\th & crid;",
        "\t\th & amount;",
        "\t\th & level;",
        "\t}",
        "};"
      ]
    },
    "lib/CCreatureHandler.cpp": {
      "path": "/root/heroes3-ai-lab/src/vcmi-adv/lib/CCreatureHandler.cpp",
      "sha256": "25e6053a46aea6520c9e8f736051430291e71740a333310c934c1925b5d37020",
