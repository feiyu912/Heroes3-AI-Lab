      "lines": [
        "si32 CCreature::maxAmount(const TResources &res) const //how many creatures can be bought",
        "{",
        "\tint ret = 2147483645;",
        "\tint resAmnt = static_cast<int>(std::min(res.size(),cost.size()));",
        "\tfor(int i=0;i<resAmnt;i++)",
        "\t\tif(cost[i])",
        "\t\t\tret = std::min(ret, (res[i] / cost[i]));",
        "\treturn ret;",
        "}"
      ]
    },
