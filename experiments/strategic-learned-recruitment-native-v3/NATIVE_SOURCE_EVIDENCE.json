      "lines": [
        "bool CGameHandler::recruitCreatures(ObjectInstanceID objid, ObjectInstanceID dstid, CreatureID crid, int32_t cram, int32_t fromLvl, PlayerColor player)",
        "{",
        "\tconst auto * dwelling = dynamic_cast<const CGDwelling *>(gameInfo().getObj(objid));",
        "\tconst auto * town = dynamic_cast<const CGTownInstance *>(gameInfo().getObj(objid));",
        "\tconst auto * army = dynamic_cast<const CArmedInstance *>(gameInfo().getObj(dstid));",
        "\tconst auto * hero = dynamic_cast<const CGHeroInstance *>(gameInfo().getObj(dstid));",
        "\tconst auto * c = crid.toCreature();",
        "",
        "\tconst bool warMachine = c->warMachine != ArtifactID::NONE;",
        "",
        "\t//TODO: check if hero is actually visiting object",
        "",
        "\tCOMPLAIN_RET_FALSE_IF(!dwelling || !army, \"Cannot recruit: invalid object!\");",
        "\tCOMPLAIN_RET_FALSE_IF(dwelling->getOwner() != player && dwelling->getOwner() != PlayerColor::UNFLAGGABLE, \"Cannot recruit: dwelling not owned!\");",
        "",
        "\tif (town)",
        "\t{",
        "\t\tCOMPLAIN_RET_FALSE_IF(town != army && !hero, \"Cannot recruit: invalid destination!\");",
        "\t\tCOMPLAIN_RET_FALSE_IF(hero != town->getGarrisonHero() && hero != town->getVisitingHero(), \"Cannot recruit: can only recruit to town or hero in town!!\");",
        "\t}",
        "\telse",
        "\t{",
        "\t\tCOMPLAIN_RET_FALSE_IF(getVisitingHero(dwelling) != hero, \"Cannot recruit: can only recruit by visiting hero!\");",
        "\t\tCOMPLAIN_RET_FALSE_IF(!hero || hero->getOwner() != player, \"Cannot recruit: can only recruit to owned hero!\");",
        "\t}",
        "",
        "\t//verify",
        "\tbool found = false;",
        "\tint level = 0;",
        "",
        "\tfor (; level < dwelling->creatures.size(); level++) //iterate through all levels",
        "\t{",
        "\t\tif ((fromLvl != -1) && (level !=fromLvl))",
        "\t\t\tcontinue;",
        "\t\tconst auto &cur = dwelling->creatures.at(level); //current level info <amount, list of cr. ids>",
        "\t\tint i = 0;",
        "\t\tfor (; i < cur.second.size(); i++) //look for crid among available creatures list on current level",
        "\t\t\tif (cur.second.at(i) == crid)",
        "\t\t\t\tbreak;",
        "",
        "\t\tif (i < cur.second.size())",
        "\t\t{",
        "\t\t\tfound = true;",
        "\t\t\tcram = std::min<int32_t>(cram, cur.first); //reduce recruited amount up to available amount",
        "\t\t\tbreak;",
        "\t\t}",
        "\t}",
        "\tSlotID slot = army->getSlotFor(crid);",
        "",
        "\tif((!found && complain(\"Cannot recruit: no such creatures!\"))",
        "\t\t|| (cram > LIBRARY->creh->objects.at(crid)->maxAmount(gameInfo().getPlayerState(army->tempOwner)->resources) && complain(\"Cannot recruit: lack of resources!\"))",
        "\t\t|| (cram <= 0 && complain(\"Cannot recruit: cram <= 0!\"))",
        "\t\t|| (!slot.validSlot() && !warMachine && complain(\"Cannot recruit: no available slot!\")))",
        "\t{",
        "\t\treturn false;",
        "\t}",
        "",
        "\t//recruit",
        "\tTResources cost = (c->getFullRecruitCost() * cram);",
        "\tgiveResources(army->tempOwner, -cost);",
        "\tstatistics->getPlayerAccumulator(army->tempOwner).spentResourcesForArmy += cost;",
        "",
        "\tSetAvailableCreatures sac;",
        "\tsac.tid = objid;",
        "\tsac.creatures = dwelling->creatures;",
        "\tsac.creatures[level].first -= cram;",
        "\tsendAndApply(sac);",
        "",
        "\tif (warMachine)",
        "\t{",
        "\t\tArtifactID artId = c->warMachine;",
        "\t\tconst CArtifact * art = artId.toArtifact();",
        "",
        "\t\tCOMPLAIN_RET_FALSE_IF(!hero, \"Only hero can buy war machines\");",
        "\t\tCOMPLAIN_RET_FALSE_IF(artId == ArtifactID::CATAPULT, \"Catapult cannot be recruited!\");",
        "\t\tCOMPLAIN_RET_FALSE_IF(nullptr == art, \"Invalid war machine artifact\");",
        "\t\tCOMPLAIN_RET_FALSE_IF(hero->hasArt(artId),\"Hero already has this machine!\");",
        "",
        "\t\tbool hasFreeSlot = false;",
        "\t\tfor(auto possibleSlot : art->getPossibleSlots().at(ArtBearer::HERO))",
        "\t\t\tif (hero->getArt(possibleSlot) == nullptr)",
        "\t\t\t\thasFreeSlot = true;",
        "",
        "\t\tif (!hasFreeSlot)",
        "\t\t{",
        "\t\t\tauto possibleSlot = art->getPossibleSlots().at(ArtBearer::HERO).front();",
        "\t\t\tremoveArtifact(ArtifactLocation(hero->id, possibleSlot));",
        "\t\t}",
        "\t\treturn giveHeroNewArtifact(hero, artId, ArtifactPosition::FIRST_AVAILABLE);",
        "\t}",
        "\telse",
        "\t{",
        "\t\taddToSlot(StackLocation(army->id, slot), c, cram);",
        "\t}",
        "\treturn true;"
      ]
    },
    "server/NetPacksServer.cpp": {
      "path": "/root/heroes3-ai-lab/src/vcmi-adv/server/NetPacksServer.cpp",
      "sha256": "3b70ad9a109c1cf41bd34cfc5767d6ea6c5dc5cbafba54e35515358d1ea8de3b",
